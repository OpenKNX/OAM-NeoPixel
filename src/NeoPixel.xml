<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_20/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns="http://knx.org/xml/project/20" xmlns:op="http://github.com/OpenKNX/OpenKNXproducer">
  <op:config href="NeoPixel.conf.xml" />
  <op:ETS
    OpenKnxId="0xAF"
    ApplicationNumber="1"
    ApplicationVersion="0.1"
    ReplacesVersions="0.0" 
    ApplicationRevision="0"
    ProductName="NeoPixel KNX Adapter"
    BusCurrent="30"
    BuildSuffix="-Dev"
    BuildSuffixText=" (Dev)"
    MediumTypes="MT-0 MT-5"
    OrderNumber="NeoPixel" />

  <op:define prefix="BASE" ModuleType="10"
    share="../lib/OGM-Common/src/Common.share.xml" >
    <op:verify File="../lib/OGM-Common/library.json" ModuleVersion="%BASE_VerifyVersion%" />
  </op:define>

  <op:define prefix="NET" ModuleType="11"
    share="../lib/OFM-Network/src/Network.share.xml">
    <op:verify File="../lib/OFM-Network/library.json" ModuleVersion="%NET_VerifyVersion%" /> 
  </op:define>

  <op:define prefix="UCT" ModuleType="19"
      share="../lib/OFM-ConfigTransfer/src/ConfigTransfer.share.xml">
      <op:verify File="../lib/OFM-ConfigTransfer/library.json" ModuleVersion="%UCT_VerifyVersion%" />
  </op:define>

  <op:define prefix="LOG" ModuleType="10"
    share="../lib/OFM-LogicModule/src/Logikmodul.share.xml"
    template="../lib/OFM-LogicModule/src/Logikmodul.templ.xml"
    NumChannels="20" 
    KoOffset="340">
    <op:verify File="../lib/OFM-LogicModule/library.json" ModuleVersion="%LOG_VerifyVersion%" /> 
  </op:define>

  <!-- BEGIN AUTO-GENERATED: NEOEFF Module -->
  <!-- DO NOT REMOVE THIS MARKER - Used by Build-EffectParameters.ps1 -->
  <!-- Effect Parameter Types - MUST be loaded BEFORE NEO module! -->
  <op:define prefix="NEOEFF" ModuleType="40"
    share="NeoPixel.Effects.ParameterTypes.generated.xml">
  </op:define>
  <!-- END AUTO-GENERATED: NEOEFF Module -->

  <op:define prefix="NEO" ModuleType="40"
    share="NeoPixel.share.xml"
    template="NeoPixel.Segment.templ.xml"
    NumChannels="16"
    KoOffset="600"
    KoSingleOffset="400">
    <op:verify File="../library.json" ModuleVersion="%NEO_VerifyVersion%" />
  </op:define>

  <op:define prefix="NEOSTRIP" ModuleType="40"
    template="NeoPixel.Strip.templ.xml"
    NumChannels="6"
    prefixDoc="NEO"
    configTransferName="  Strip"
    KoOffset="500">
  </op:define>
<generate>
            <Dynamic>
            <op:include href="../lib/OGM-Common/src/Common.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="BASE" />
            <op:include href="../lib/OFM-Network/src/Network.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="NET" />
            <op:include href="../lib/OFM-ConfigTransfer/src/ConfigTransfer.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="UCT" />
            <op:include href="../lib/OFM-LogicModule/src/Logikmodul.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="LOG" />
            <op:include href="NeoPixel.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="NEO" />
          </Dynamic>
</generate>
</KNX>