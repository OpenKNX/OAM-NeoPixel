                      <ParameterRefRef RefId="%AID%_UP-%TT%9%C%031_R-%TT%9%C%03101" IndentLevel="1" HelpContext="%DOC%"/>
                      <!-- Voltage (für Leistungsberechnung) -->
                      <ParameterRefRef RefId="%AID%_UP-%TT%9%C%039_R-%TT%9%C%03901" IndentLevel="1" HelpContext="%DOC%"/>
                      <!-- LED Swap (jetzt mit besserem Text) -->
                      <ParameterRefRef RefId="%AID%_UP-%TT%9%C%032_R-%TT%9%C%03201" IndentLevel="1" HelpContext="%DOC%"/>
                      <!-- Signal-Polaritaet: nur 1-Wire. SPI-LEDs haben eine eigene Taktleitung.
                           SPI-Chipsets: APA102(5), SK9822(6), WS2801(21), LPD8806(22), LPD6803(23), P9813(24), APA102-Clone(25) -->
                      <choose ParamRefId="%AID%_UP-%TT%9%C%030_R-%TT%9%C%03001">
                        <when test="5 6 21 22 23 24 25"><!-- SPI: Polaritaet nicht anwendbar --></when>
                        <when default="true">
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%073_R-%TT%9%C%07301" IndentLevel="1" HelpContext="%DOC%"/>
                        </when>
                      </choose>
                      <!-- Weiss-Berechnung: nur Typen mit Weisskanal (4, 5 oder 6 Kanaele laut mapProtocol) -->
                      <choose ParamRefId="%AID%_UP-%TT%9%C%030_R-%TT%9%C%03001">
                        <when test="1 4 8 9 15 16 17 18 30 31">
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%074_R-%TT%9%C%07401" IndentLevel="1" HelpContext="%DOC%"/>
                        </when>
                        <when default="true"><!-- RGB-Typen: kein Weisskanal --></when>
                      </choose>
                      <!-- Auffrischen im Aus-Zustand: fuer alle Typen sinnvoll -->
                      <ParameterRefRef RefId="%AID%_UP-%TT%9%C%075_R-%TT%9%C%07501" IndentLevel="1" HelpContext="%DOC%"/>
                      <!-- Timing nur bei 1-Wire; SPI-LEDs takten ueber "SPI Clock" -> ausblenden -->
                      <choose ParamRefId="%AID%_UP-%TT%9%C%030_R-%TT%9%C%03001">
                        <when test="5 6 21 22 23 24 25"><!-- SPI: kein Bitrate-Timing --></when>
                        <when default="true">
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%072_R-%TT%9%C%07201" IndentLevel="1" HelpContext="%DOC%"/>
                        </when>
                      </choose>
                      <!-- Anzahl LEDs -->
                      <ParameterRefRef RefId="%AID%_UP-%TT%9%C%037_R-%TT%9%C%03701" IndentLevel="1" HelpContext="%DOC%"/>
                      <!-- Überspringe erste LEDs -->
                      <ParameterRefRef RefId="%AID%_UP-%TT%9%C%038_R-%TT%9%C%03801" IndentLevel="1" HelpContext="%DOC%"/>
                      
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="Port-Zuweisung:" UIHint="Headline" />
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="Wählen Sie die Anschluss-Ports für die Daten- und (bei SPI-LEDs) Takt-Leitung. Die verfügbaren Ports sind hardwareabhängig. Beachten Sie die Dokumentation Ihrer OpenKNX-Hardware für die korrekte Port-Belegung und mögliche Port-Konflikte." UIHint="Information" />
                      
                      <!-- ═══════════════════════════════════════════════════════════════════════════════════
                           HARDWARE GPIO CONFLICT STATUS DISPLAY (from Hardware.templ.xml)
                           Shows red error when GPIO port conflicts detected
                           ═══════════════════════════════════════════════════════════════════════════════════ -->
                      <op:include href="NeoPixel.Hardware.templ.xml" xpath="//HardwareGPIOConfig/UIElements/GPIOConflictStatus/*" />
                      
                      <!-- ═══════════════════════════════════════════════════════════════════════════════════
                           HARDWARE GPIO PORT SELECTION UI (from Hardware.templ.xml)
                           ═══════════════════════════════════════════════════════════════════════════════════ -->
                      <op:include href="NeoPixel.Hardware.templ.xml" xpath="//HardwareGPIOConfig/UIElements/GPIOPortSelection/*" />

                      
                      <!-- Clock Port Selection (only for SPI LEDs) -->
                      <choose ParamRefId="%AID%_UP-%TT%9%C%030_R-%TT%9%C%03001">
                        <!-- SPI-Chipsets: APA102(5), SK9822(6), WS2801(21), LPD8806(22), LPD6803(23), P9813(24), APA102-Clone(25) -->
                        <when test="5 6 21 22 23 24 25">
                          <!-- ═══════════════════════════════════════════════════════════════════════════════════
                               HARDWARE GPIO CLOCK SELECTION UI (from Hardware.templ.xml)
                               ═══════════════════════════════════════════════════════════════════════════════════ -->
                          <op:include href="NeoPixel.Hardware.templ.xml" xpath="//HardwareGPIOConfig/UIElements/GPIOClockSelection/*" />
                        </when>
                      </choose>
                      
                      <!-- ═══════════════════════════════════════════════════════════════════════════════════
                           HARDWARE GPIO CONFLICT WARNING UI (from Hardware.templ.xml)
                           ═══════════════════════════════════════════════════════════════════════════════════ -->
                      <op:include href="NeoPixel.Hardware.templ.xml" xpath="//HardwareGPIOConfig/UIElements/GPIOConflictWarning/*" />
                      
                      <!-- ═══════════════════════════════════════════════════════════════════════════════════
                            SPI CLOCK CONFIGURATION (only for SPI LEDs)
                            ═══════════════════════════════════════════════════════════════════════════════════ -->
                      <choose ParamRefId="%AID%_UP-%TT%9%C%030_R-%TT%9%C%03001">
                        <!-- SPI-Chipsets: APA102(5), SK9822(6), WS2801(21), LPD8806(22), LPD6803(23), P9813(24), APA102-Clone(25) -->
                        <when test="5 6 21 22 23 24 25">
                          <!-- SPI Takt -->
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%070_R-%TT%9%C%07001" IndentLevel="1" HelpContext="%DOC%"/>
                          <choose ParamRefId="%AID%_UP-%TT%9%C%070_R-%TT%9%C%07001">
                            <when test="1">
                              <!-- Warnung bei manuellem SPI Takt -->
                              <ParameterSeparator Id="%AID%_PS-nnn" Text="Die manuelle SPI-Takt-Konfiguration kann zu Problemen führen!&#xD;&#xA;Bei zu hohen Frequenzen können die LEDs flackern oder nicht funktionieren." UIHint="Information" />
                              <!-- SPI Clock Frequenz -->
                              <ParameterRefRef RefId="%AID%_UP-%TT%9%C%036_R-%TT%9%C%03601" IndentLevel="2" HelpContext="%DOC%"/>
                            </when>
                          </choose>
                        </when>
                      </choose>

                      <!-- ═══════════════════════════════════════════════════════════════════════════════════
                           FARBKALIBRIERUNG (Master-Checkbox blendet komplette Sektion ein/aus)
                           ═══════════════════════════════════════════════════════════════════════════════════ -->
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="Farbkalibrierung:" UIHint="Headline" />
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="Optimiert die Farbwiedergabe durch Weißabgleich und Gamma-Korrektur. Der Weißabgleich kompensiert Fertigungstoleranzen der LEDs, die Gamma-Korrektur sorgt für eine natürlichere Helligkeitswahrnehmung (empfohlen)."/>
                      <!-- Master-Checkbox: Farbkalibrierung -->
                      <ParameterRefRef RefId="%AID%_UP-%TT%9%C%046_R-%TT%9%C%04601" IndentLevel="1" HelpContext="%DOC%"/>
                      <choose ParamRefId="%AID%_UP-%TT%9%C%046_R-%TT%9%C%04601">
                        <when test="1"> <!-- Farbkalibrierung aktiviert -->
                          <!-- Weißabgleich Sub-Sektion -->
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Weißabgleich (RGB-Korrektur):" UIHint="Headline" />
                          <!-- Weißabgleich Rot (%) -->
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%067_R-%TT%9%C%06701" IndentLevel="2" HelpContext="NEO-Weissabgleich-Rot"/>
                          <!-- Weißabgleich Grün (%) -->
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%068_R-%TT%9%C%06801" IndentLevel="2" HelpContext="NEO-Weissabgleich-Gruen"/>
                          <!-- Weißabgleich Blau (%) -->
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%069_R-%TT%9%C%06901" IndentLevel="2" HelpContext="NEO-Weissabgleich-Blau"/>
                          
                          <!-- Gamma-Korrektur Sub-Sektion -->
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Gamma-Korrektur:" UIHint="Headline" />
                          <!-- Checkbox: Gamma-Korrektur -->
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%047_R-%TT%9%C%04701" IndentLevel="2" HelpContext="%DOC%"/>
                          <choose ParamRefId="%AID%_UP-%TT%9%C%047_R-%TT%9%C%04701">
                            <!-- Gamma aktiviert -->
                            <when test="1"> 
                              <!-- Gamma-Wert -->
                              <ParameterRefRef RefId="%AID%_UP-%TT%9%C%048_R-%TT%9%C%04801" IndentLevel="3" HelpContext="%DOC%"/>
                            </when>
                          </choose>
                        </when>
                      </choose>
                      <!-- ═══════════════════════════════════════════════════════════════════════════════════
                           STROMBEGRENZUNG (Flattened: 0=Aus, 1=Global, 2=Fester Wert, 3=Pro LED)
                           ═══════════════════════════════════════════════════════════════════════════════════ -->
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="Strombegrenzung:" UIHint="Headline" />
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="Intelligente Strombegrenzung mit ABL (automatische Helligkeitsreduktion) schützt vor Überlastung. Die Helligkeit wird dynamisch an den berechneten Stromverbrauch angepasst. Hier können die globalen Einstellungen überschrieben werden." />
                      
                      <ParameterRefRef RefId="%AID%_UP-%TT%9%C%081_R-%TT%9%C%08101" IndentLevel="1" HelpContext="NEO-Strombegrenzung"/>
                      <choose ParamRefId="%AID%_UP-%TT%9%C%081_R-%TT%9%C%08101">
                        <!-- Mode 2: Benutzerdefiniert (Fester Wert) -->
                        <when test="2">
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%043_R-%TT%9%C%04301" IndentLevel="2" HelpContext="%DOC%"/>
                          <!-- ABL Settings -->
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Automatische Helligkeitsreduktion (ABL):" UIHint="Headline" />
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%044_R-%TT%9%C%04401" IndentLevel="2" HelpContext="%DOC%"/>
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%045_R-%TT%9%C%04501" IndentLevel="2" HelpContext="%DOC%"/>
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%066_R-%TT%9%C%06601" IndentLevel="2" HelpContext="%DOC%"/>
                        </when>
                        <!-- Mode 3: Benutzerdefiniert (Pro LED) -->
                        <when test="3">
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%042_R-%TT%9%C%04201" IndentLevel="2" HelpContext="%DOC%"/>
                          <!-- ABL Settings -->
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Automatische Helligkeitsreduktion (ABL):" UIHint="Headline" />
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%044_R-%TT%9%C%04401" IndentLevel="2" HelpContext="%DOC%"/>
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%045_R-%TT%9%C%04501" IndentLevel="2" HelpContext="%DOC%"/>
                          <ParameterRefRef RefId="%AID%_UP-%TT%9%C%066_R-%TT%9%C%06601" IndentLevel="2" HelpContext="%DOC%"/>
                        </when>
                      </choose>
                      
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
