                      <!-- SPI Takt Configuration (nur für SPI) -->
                      <choose ParamRefId="%AID%_UP-%TT%9%C%030_R-%TT%9%C%03001">
                        <!-- SPI-Chipsets: APA102(5), WS2801(21), LPD8806(22), LPD6803(23), P9813(24), APA102-Clone(25) -->
