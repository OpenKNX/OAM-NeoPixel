                        <!-- SPI Takt -->
                        <ParameterRefRef RefId="%AID%_UP-%TT%9%C%070_R-%TT%9%C%07001" IndentLevel="1" HelpContext="%DOC%"/>
                        <choose ParamRefId="%AID%_UP-%TT%9%C%070_R-%TT%9%C%07001">
                          <when test="1">
                            <!-- Warnung bei manuellem SPI Takt -->
                            <ParameterSeparator Id="%AID%_PS-nnn" Text="Die manuelle SPI-Takt-Konfiguration kann zu Problemen führen!&#xD;&#xA;Bei zu hohen Frequenzen können die LEDs flackern oder nicht funktionieren." UIHint="Information" />
