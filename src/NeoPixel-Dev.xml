<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_20/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns="http://knx.org/xml/project/20" xmlns:op="http://github.com/OpenKNX/OpenKNXproducer">
  <op:config href="NeoPixel.conf.xml" />
  <!-- hardware feature flags (%NEOHW_...%), generated by OGM-HardwareConfig/generator from HardwareProfile.xml -->
  <op:config href="NeoPixel.hw.conf.xml" />
  <!-- page "Info LEDs" of OGM-Common per device (HardwareProfile.xml <PartRows>); href relative to lib/OGM-Common/src, set before
       Common.share.xml sets its default -->
  <op:config name="%BASE_InfoLedPart%" value="../../../src/NeoPixel.hw.infoled.gen.xml" />
  <!-- Product version text (page "Allgemein"), per variant; keep it in sync with ApplicationVersion below. -->
  <op:config name="%NEO_ProductVersion%" value="3.0" />
  <op:ETS
    OpenKnxId="0xAD"
    ApplicationNumber="1"
    ApplicationVersion="3.0"
    ReplacesVersionsDownTo="0.14"
    ApplicationRevision="0"
    ProductName="OpenKNX NeoPixel"
    BusCurrent="30"
    BuildSuffix="-Dev"
    BuildSuffixText=" (Dev)"
    MediumTypes="MT-0 MT-5"
    OrderNumber="NeoPixel" />

  <op:define prefix="BASE" ModuleType="10"
    share="../lib/OGM-Common/src/Common.share.xml" >
    <op:verify File="../lib/OGM-Common/library.json" ModuleVersion="%BASE_VerifyVersion%" />
  </op:define>

  <op:define prefix="NET" ModuleType="11"
    share="../lib/OFM-Network/src/Network.share.xml">
    <op:verify File="../lib/OFM-Network/library.json" ModuleVersion="%NET_VerifyVersion%" /> 
  </op:define>

  <op:define prefix="UCT" ModuleType="19"
      share="../lib/OFM-ConfigTransfer/src/ConfigTransfer.share.xml">
      <op:verify File="../lib/OFM-ConfigTransfer/library.json" ModuleVersion="%UCT_VerifyVersion%" />
  </op:define>

  <op:define prefix="LOG" ModuleType="10"
    share="../lib/OFM-LogicModule/src/Logikmodul.share.xml"
    template="../lib/OFM-LogicModule/src/Logikmodul.templ.xml"
    NumChannels="50"
    KoOffset="100">
    <op:verify File="../lib/OFM-LogicModule/library.json" ModuleVersion="%LOG_VerifyVersion%" /> 
  </op:define>
  <op:define prefix="FCB"
    share="../lib/OFM-FunctionBlocks/src/FunctionBlocks.share.xml"
    template="../lib/OFM-FunctionBlocks/src/FunctionBlocks.templ.xml"
    NumChannels="15"
    KoOffset="250"
    ModuleType="26">
    <op:verify File="../lib/OFM-FunctionBlocks/library.json" ModuleVersion="%FCB_VerifyVersion%" />
  </op:define>

  <op:define prefix="LMG" ModuleType="41"
    share="../lib/OFM-LightManager/src/LightManagerModule.share.xml"
    template="../lib/OFM-LightManager/src/LightManagerModule.templ.xml"
    NumChannels="16"
    KoSingleOffset="1460"
    KoOffset="1500">
    <op:verify File="../lib/OFM-LightManager/library.json" ModuleVersion="%LMG_VerifyVersion%" />
  </op:define>

  <op:define prefix="NEO" ModuleType="40"
    share="NeoPixel.share.xml"
    template="NeoPixel.Segment.templ.xml"
    NumChannels="16"
    configTransferName="NeoPixel (Allgemein + Segmente)"
    KoOffset="600"
    KoSingleOffset="400">
    <op:verify File="../library.json" ModuleVersion="%NEO_VerifyVersion%" />
  </op:define>

  <op:define prefix="NEOSTRIP" ModuleType="40"
    share="NeoPixel.Strip.share.xml"
    template="NeoPixel.Strip.templ.xml"
    NumChannels="8"
    prefixDoc="NEO"
    configTransferName="NeoPixel Streifen (Hardware)"
    KoOffset="500">
  </op:define>

  <!-- Effect manager KOs - separate module. KoOffset 1860: NEO segment block 53 KOs per channel
       => 600..1447, LMG single 1460 / channel 1500..1851, so EM starts at 1860. -->

  <op:define prefix="NEOEM" ModuleType="42"
    share="NeoPixel.EM.share.xml"
    template="NeoPixel.EM.templ.xml"
    NumChannels="16"
    configTransferName="NeoPixel Effektmanager"
    KoOffset="1860">
  </op:define>

  <op:define prefix="FTM" ModuleType="13" share="../lib/OFM-FileTransferModule/src/FileTransfer.share.xml" />
  <!-- WiFi settings (operating mode, setup WiFi, own AP); shown with "WiFi-Schnittstelle: Ja", one knxprod for TP, LAN and WiFi -->
  <op:define prefix="NETW" ModuleType="14" share="../lib/OFM-Network/src/NetworkWifi.share.xml">
    <op:verify File="../lib/OFM-Network/library.json" ModuleVersion="%NET_VerifyVersion%" />
  </op:define>

  <!-- hardware module, generated by OGM-HardwareConfig/generator from HardwareProfile.xml: hardware selection
       (stores the DEVICE_HW_ID), device query, capability page. Last define: its memory follows all other modules.
       Submodule of NEO: no own "Module" checkbox, so the selection cannot be switched off on its own (off = 0 = every port off). -->
  <op:define prefix="NEOHW" ModuleType="45" isSubmoduleOf="NEO" configTransferName="Gerät" share="NeoPixel.hw.module.gen.xml" />
  <!-- developer view of the hardware page (generated with the hardware module, HardwareProfile.xml <Page dev>): a memoryless
       checkbox and the technical data per board; references to NEOHW are written with its ModuleType 45 -->
  <op:define prefix="NEOHWDEV" ModuleType="46" isSubmoduleOf="NEO" share="NeoPixel.hw.dev.gen.xml" />

<generate>
            <Dynamic>
            <!-- BASE Main channel, rebuilt in place (position preserved) so composed modules can be injected
                 below Common's own "Erweitert" content. Convention: a module whose share ships a
                 ParameterBlock Name="ExtendedInject" is folded in via the op:include below -> the section
                 appears iff that module is op:define'd (auto-conditional, pure XML).
                 Unlike OAM-IP-Interface this KEEPS OpenKNXproducerGeneratedModules: NeoPixel registers
                 ConfigTransfer (UCT), so the producer post-process completes that block, and it carries the
                 per-module "Modul aktivieren" checkboxes (FTM = UP-0099813). -->
            <Channel Id="%AID%_CH-BASE" Number="BASE" Name="BASE_Main" Text="OpenKNX" Icon="openknx" HelpContext="BASE-OpenKNX">
              <!-- Allgemein (Basic) -->
              <op:include href="../lib/OGM-Common/src/Common.share.xml" xpath="//ApplicationProgram/Dynamic/Channel/ParameterBlock[@Name='Basic']" prefix="BASE" />
              <!-- Hardware page of the generated hardware module (NEOHW, HardwareProfile.xml <Page>) directly after "Allgemein" -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Hardware" Text="{{0:%NEOHW_PageText%}}" TextParameterRefId="%NEOHW_PageTextRef%" Icon="%NEOHW_PageIcon%" HelpContext="%NEOHW_PageHelp%">
                <op:include href="NeoPixel.hw.module.gen.xml" xpath="//ApplicationProgram/Dynamic/Channel/ParameterBlock[@Name='Profile']/*" IsInner="true" prefix="NEOHW" />
                <!-- Info LED function per board (HardwareProfile.xml <Fix name="InfoLed<n>" show="assign">): set when the board is selected;
                     an Assign must sit in a ParameterBlock (ETS schema), so the blocks go into the hardware page -->
                <op:include href="NeoPixel.hw.fixes.gen.xml" xpath="//Block[@name='Fix_InfoLed1' or @name='Fix_InfoLed2' or @name='Fix_InfoLed3']/*" />
                <!-- developer view (module NEOHWDEV, development product only) -->
                <op:include href="NeoPixel.hw.dev.gen.xml" xpath="//ApplicationProgram/Dynamic/Channel/ParameterBlock[@Name='DevView']/*" IsInner="true" prefix="NEOHWDEV" />
              </ParameterBlock>
              <!-- Erweitert (Extended): Common's own content first, then the module injections -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Extended" Text="Erweitert" Icon="format-list-text" HelpContext="BASE-OpenKNX">
                <op:include href="../lib/OGM-Common/src/Common.share.xml" xpath="//ApplicationProgram/Dynamic/Channel/ParameterBlock[@Name='Extended']/*" IsInner="true" prefix="BASE" />
                <op:include href="../lib/OFM-FileTransferModule/src/FileTransfer.share.xml" xpath="//Dynamic/Channel/ParameterBlock/*" IsInner="true" prefix="FTM" />
              </ParameterBlock>
              <!-- Remaining BASE pages (Info LEDs, Module, Hilfe) in original order; Basic/Extended placed above -->
              <op:include href="../lib/OGM-Common/src/Common.share.xml" xpath="//ApplicationProgram/Dynamic/Channel/*[not(self::ParameterBlock[@Name='Basic']) and not(self::ParameterBlock[@Name='Extended'])]" prefix="BASE" />
            </Channel>
            <!-- Network channel rebuilt so the WiFi module (NETW) folds in: its selection at the end of "Allgemein",
                 its "WiFi" page below, shown only with "WiFi-Schnittstelle: Ja". -->
            <Channel Id="%AID%_CH-NET" Number="NET" Name="Main" Text="Netzwerk" Icon="ethernet" HelpContext="NET-Dokumentation">
              <ParameterBlock Id="%AID%_PB-nnn" Name="Basic" Text="Allgemein" Icon="cog-outline" HelpContext="NET-Dokumentation">
                <op:include href="../lib/OFM-Network/src/Network.share.xml" xpath="//Dynamic/Channel/ParameterBlock[@Name='Basic']/*" IsInner="true" prefix="NET" />
                <!-- WiFi settings only on hardware whose firmware has WiFi (KNX_IP_WIFI, HardwareProfile.xml capability Wifi); also while no
                     hardware is selected (state after the app update), so a download does not reset them -->
                <choose ParamRefId="%NEOHW_SelectRef%">
                  <when test="%NEOHW_CAP_Wifi_OR_NONE%">
                    <!-- NetworkInject without its row "WiFi-Schnittstelle" (HasWifi, ref ..01001_R-..): block Fix_HasWifi below sets it to Ja
                         and shows it read-only on hardware with WiFi (HardwareProfile.xml <Fixes>), the normal row while none is selected -->
                    <op:include href="../lib/OFM-Network/src/NetworkWifi.share.xml" xpath="//Dynamic/Channel/ParameterBlock[@Name='NetworkInject']/*[not(contains(@RefId, '%TT%01001_R-'))]" IsInner="true" prefix="NETW" />
                    <op:include href="NeoPixel.hw.fixes.gen.xml" xpath="//Block[@name='Fix_HasWifi']/*" />
                  </when>
                </choose>
              </ParameterBlock>
              <op:include href="../lib/OFM-Network/src/Network.share.xml" xpath="//Dynamic/Channel/*[not(self::ParameterBlock[@Name='Basic'])]" prefix="NET" />
              <choose ParamRefId="%NEOHW_SelectRef%">
                <when test="%NEOHW_CAP_Wifi_OR_NONE%">
                  <op:include href="../lib/OFM-Network/src/NetworkWifi.share.xml" xpath="//Dynamic/Channel/choose" prefix="NETW" />
                </when>
              </choose>
            </Channel>
            <op:include href="../lib/OFM-ConfigTransfer/src/ConfigTransfer.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="UCT" />
            <op:include href="../lib/OFM-LogicModule/src/Logikmodul.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="LOG" />
            <op:include href="../lib/OFM-FunctionBlocks/src/FunctionBlocks.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="FCB" />
            <op:include href="../lib/OFM-LightManager/src/LightManagerModule.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="LMG" />
            <op:include href="NeoPixel.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="NEO" />
          </Dynamic>
</generate>
</KNX>
