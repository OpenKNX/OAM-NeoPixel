              <Parameter Id="%AID%_P-%TT%%CC%288" Name="NEOEM%C%Cue9FxAvail" ParameterType="%AID%_PT-NEOEffectAvail" Text="Effekt-Verfuegbarkeit Cue 9" Value="0" Access="None" />
              <Parameter Id="%AID%_P-%TT%%CC%289" Name="NEOEM%C%Cue10FxAvail" ParameterType="%AID%_PT-NEOEffectAvail" Text="Effekt-Verfuegbarkeit Cue 10" Value="0" Access="None" />
