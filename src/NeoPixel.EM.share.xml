<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_20/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/20" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">

  <ManufacturerData>
  <Manufacturer RefId="M-00FA">
    <ApplicationPrograms>
      <ApplicationProgram>
        <Static>
          <ParameterTypes>

            <!-- EM Aktiv (Checkbox, 0=Aus, 1=Ein) -->
            <!-- 3-Zustand (war Checkbox 0/1): 8-Bit bleibt -> wertstabil zu Bestand (0=aus->Deaktiviert, 1=an->Aktiv); 2=Suspendiert neu. -->
            <ParameterType Id="%AID%_PT-EMEnabled" Name="EMEnabled">
              <TypeRestriction Base="Value" SizeInBit="8">
                <Enumeration Text="Aktiv"    Value="1" Id="%ENID%" />
                <Enumeration Text="Deaktiviert" Value="0" Id="%ENID%" />
                <Enumeration Text="Suspendiert" Value="2" Id="%ENID%" />
              </TypeRestriction>
            </ParameterType>

            <!-- Effekt-Text KOs aktivieren (Checkbox, 1 Bit) -->
            <ParameterType Id="%AID%_PT-EMTextKOs" Name="EMTextKOs">
              <TypeNumber SizeInBit="1" Type="unsignedInt" minInclusive="0" maxInclusive="1" UIHint="CheckBox" />
            </ParameterType>

            <!-- EM Name (16 chars) -->
            <ParameterType Id="%AID%_PT-EMName" Name="EMName">
              <TypeText SizeInBit="320" />
            </ParameterType>

            <!-- EM Display-Name = roher Name + JS-Zustands-Marker (⛔ Deaktiviert / ⏸ Suspendiert),
                 berechnet via ParameterCalculation BASE_MarkInactiveChannel. Nicht gespeichert (Access=None,
                 ohne Offset) -> kostet keinen Speicher; nur fuer Baum-Titel & KO-Namen via TextParameterRefId. -->
            <ParameterType Id="%AID%_PT-EMDisplayName" Name="EMDisplayName">
              <TypeText SizeInBit="384" />
            </ParameterType>

            <!-- EM Loop (1 bit) -->
            <ParameterType Id="%AID%_PT-EMLoop" Name="EMLoop">
              <TypeRestriction Base="Value" SizeInBit="1" UIHint="DropDown">
                <Enumeration Text="Nein — EM stoppt nach letzter Cue" Value="0" Id="%AID%_PT-EMLoop_EN-0"/>
                <Enumeration Text="Ja — EM wiederholt von Cue 1" Value="1" Id="%AID%_PT-EMLoop_EN-1"/>
              </TypeRestriction>
            </ParameterType>

            <!-- EM Folgeziel (0-16, 0=stop) -->
            <ParameterType Id="%AID%_PT-EMNext" Name="EMFolgeziel">
              <TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
                <Enumeration Text="Stop" Value="0" Id="%AID%_PT-EMNext_EN-0"/>
                <Enumeration Text="Effektmanager 1"  Value="1"  Id="%AID%_PT-EMNext_EN-1"/>
                <Enumeration Text="Effektmanager 2"  Value="2"  Id="%AID%_PT-EMNext_EN-2"/>
                <Enumeration Text="Effektmanager 3"  Value="3"  Id="%AID%_PT-EMNext_EN-3"/>
                <Enumeration Text="Effektmanager 4"  Value="4"  Id="%AID%_PT-EMNext_EN-4"/>
                <Enumeration Text="Effektmanager 5"  Value="5"  Id="%AID%_PT-EMNext_EN-5"/>
                <Enumeration Text="Effektmanager 6"  Value="6"  Id="%AID%_PT-EMNext_EN-6"/>
                <Enumeration Text="Effektmanager 7"  Value="7"  Id="%AID%_PT-EMNext_EN-7"/>
                <Enumeration Text="Effektmanager 8"  Value="8"  Id="%AID%_PT-EMNext_EN-8"/>
                <Enumeration Text="Effektmanager 9"  Value="9"  Id="%AID%_PT-EMNext_EN-9"/>
                <Enumeration Text="Effektmanager 10" Value="10" Id="%AID%_PT-EMNext_EN-10"/>
                <Enumeration Text="Effektmanager 11" Value="11" Id="%AID%_PT-EMNext_EN-11"/>
                <Enumeration Text="Effektmanager 12" Value="12" Id="%AID%_PT-EMNext_EN-12"/>
                <Enumeration Text="Effektmanager 13" Value="13" Id="%AID%_PT-EMNext_EN-13"/>
                <Enumeration Text="Effektmanager 14" Value="14" Id="%AID%_PT-EMNext_EN-14"/>
                <Enumeration Text="Effektmanager 15" Value="15" Id="%AID%_PT-EMNext_EN-15"/>
                <Enumeration Text="Effektmanager 16" Value="16" Id="%AID%_PT-EMNext_EN-16"/>
              </TypeRestriction>
            </ParameterType>

            <!-- EM Anzahl aktiver Cues (1-10) -->
            <ParameterType Id="%AID%_PT-EMCueCount" Name="EMCueAnzahl">
              <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="10"/>
            </ParameterType>

            <!-- Cue Effekt (Dropdown, aktualisiert durch Build-EffectParameters.ps1) -->
            <ParameterType Id="%AID%_PT-CueEffect" Name="CueEffect">
              <TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
                <!-- GENERATED_CUE_EFFECT_ENUMERATIONS_START -->
                <!-- Content will be generated by Build-EffectParameters.ps1 -->
                <!-- GENERATED_CUE_EFFECT_ENUMERATIONS_END -->
              </TypeRestriction>
            </ParameterType>
            <!-- Cue shared types — also used in NeoPixel.Cue.part.xml -->
            <ParameterType Id="%AID%_PT-CueParam" Name="CueParam">
              <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="255"/>
            </ParameterType>
            <ParameterType Id="%AID%_PT-CueDuration" Name="CueDuration">
              <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="0" maxInclusive="65535"/>
            </ParameterType>
            <ParameterType Id="%AID%_PT-CueFade" Name="CueFade">
              <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="0" maxInclusive="5000"/>
            </ParameterType>
            <ParameterType Id="%AID%_PT-CueText" Name="CueText">
              <TypeText SizeInBit="112" />
            </ParameterType>

          </ParameterTypes>
        </Static>
      </ApplicationProgram>
    </ApplicationPrograms>
  </Manufacturer>
  </ManufacturerData>
</KNX>
