   "do": [
    {
     "console": "neo effect set 5 0"
    },
    {
     "wait": 2500
    }
   ],
   "expect": [
    {
     "type": "console",
     "cmd": "neo phys dump 5 0 4",
     "pattern": "lit=(\\d+)",
     "group": 1,
     "value": "0",
     "op": "gt"
    },
    {
     "type": "console",
     "cmd": "neo phys dump 5 0 4",
     "pattern": "hash=([0-9A-F]+)",
     "group": 1,
     "changeMs": 1500,
