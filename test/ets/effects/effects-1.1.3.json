  {
   "id": "E-setup",
   "title": "Rolle (Segment 5) 1D, Panel A (Segment 0) 2D 8x8; Farbe rot",
   "do": [
    {
     "console": "neo color 5 255 0 0 0"
    },
    {
     "console": "neo color 0 255 0 0"
    }
   ],
   "expect": []
  },
