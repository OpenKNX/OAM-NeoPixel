      "setting": "LED-Streifen 1 und 2",
      "value": "SK6812/WS2814 (RGBW), Farbordnung GRBW, 150 / 150 LEDs"
    },
    {
      "setting": "Segment 1 Dachkante links",
      "value": "LED 1–150, Start-Farbe #000000 + W 255, HCL global"
    },
    {
      "setting": "Segment 2 Dachkante rechts",
      "value": "LED 151–240, wie Segment 1"
    },
    {
      "setting": "Segment 3 Sitzecke",
      "value": "LED 241–300, #FF9A40 + W 60, Helligkeit 180, HCL deaktiviert"
    },
    {
      "setting": "HCL",
      "value": "Globaler Lichtmanager = Lichtmanager 1; LMG-Kanal 1 aktiviert, Profil 1 an allen Tagen"
    },
    {
      "setting": "Strombegrenzung",
      "value": "Global „Fester Wert“ 5000 mA, Übergang ab 80 % der Grenze auf 80 % Helligkeit, Strom pro LED 0 = Tabelle des LED-Typs (RGB 3 × 20 mA, RGBW 4 × 20 mA), Streifen „Global verwenden“ (ein Netzteil)"
    },
    {
      "setting": "Relais 1",
      "value": "LED-Netzteil, Ausschaltverzögerung 30 s, Mindest-Auszeit 10 s, gesteuert von Logik 1+2"
    },
    {
      "setting": "Status nach Neustart senden",
      "value": "Ja (damit die Netzteil-Logik nach einem Neustart den Segmentzustand erhält)"
    }
  ],
